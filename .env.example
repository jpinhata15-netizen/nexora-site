# ============================================================================
# NEXORA — VARIÁVEIS DE AMBIENTE E INTEGRAÇÕES COMERCIAIS
# Copie este arquivo para .env.local em desenvolvimento ou configure no painel da Vercel
# ============================================================================

# URL pública oficial do site (usada em Sitemap, Robots e Open Graph)
NEXT_PUBLIC_SITE_URL="https://nexora.digital"

# 1. CANAIS DE ATENDIMENTO COMERCIAL (Também configuráveis diretamente em src/config/site.ts)
# Informe apenas números com DDI + DDD + Número (ex: 5514999999999).
# Assim que preenchido, o botão flutuante de WhatsApp e o envio direto pós-briefing são ativados.
NEXT_PUBLIC_NEXORA_WHATSAPP=""
NEXT_PUBLIC_NEXORA_WHATSAPP_DISPLAY=""

# E-mail comercial oficial da NEXORA (ex: contato@nexora.digital)
NEXT_PUBLIC_NEXORA_EMAIL=""

# 2. REDES SOCIAIS OFICIAIS (Opcionais)
NEXT_PUBLIC_NEXORA_INSTAGRAM=""
NEXT_PUBLIC_NEXORA_LINKEDIN=""
NEXT_PUBLIC_NEXORA_GITHUB=""
NEXT_PUBLIC_NEXORA_BEHANCE=""

# 3. INTEGRAÇÕES DE BACKEND PARA O FORMULÁRIO (/api/contact)
# Opção A: Webhook para automação (n8n, Make, Zapier, Slack, Discord, CRM)
NEXORA_WEBHOOK_URL=""

# Opção B: Disparo de e-mail transacional via Resend (https://resend.com)
RESEND_API_KEY=""
NEXORA_COMMERCIAL_EMAIL=""

